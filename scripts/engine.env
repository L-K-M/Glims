# Engine source and toolchain pins for the phase 0 spike (docs/plan.md).
# Sourced by scripts/bootstrap-deps.sh. Change a pin in its own commit and
# record engine moves in the update log in docs/plan.md.

GIMP_REPO="https://gitlab.gnome.org/GNOME/gimp.git"

# The dependency prefix must satisfy build/macos/all-deps-uni.txt at every ref
# listed here. The first is the pinned engine; the others are the spike's
# update drills (docs/plan.md, Phase 0 spike).
GIMP_REFS="GIMP_3_2_8 GIMP_3_2_0 master"

# MacPorts base, built from source into _deps/macports without root
# privileges. Upstream GIMP's macOS CI also uses a non-default MacPorts prefix.
MACPORTS_VERSION="2.12.7"
MACPORTS_SHA256="6a3730de846bb78e3fb4ced2ed8d13f777e6aca2ab2f59cade9ca0d549ccc4ba"

# Must equal LSMinimumSystemVersion in Resources/Info.plist (checked at run time).
DEPLOYMENT_TARGET="13.0"
