# Engine source and toolchain pins for the phase 0 spike (docs/plan.md).
# Sourced by scripts/bootstrap-deps.sh. Change a pin in its own commit and
# record engine moves in the update log in docs/plan.md.

GIMP_REPO="https://gitlab.gnome.org/GNOME/gimp.git"
BABL_REPO="https://gitlab.gnome.org/GNOME/babl.git"
GEGL_REPO="https://gitlab.gnome.org/GNOME/gegl.git"

# Engine sets as GIMP_REF:BABL_REF:GEGL_REF. The first is the pinned engine;
# the others are the spike's update drills (docs/plan.md, Phase 0 spike);
# GIMP_3_0_8 measures a minor release (3.0 to 3.2).
# For a tagged GIMP, babl and GEGL are the latest tags when that GIMP tag was
# cut, which is what upstream's CI builds it against
# (build/macos/1_build-deps-macports.sh). The dependency prefix must satisfy
# build/macos/all-deps-uni.txt at every GIMP ref listed here.
ENGINE_SETS="GIMP_3_2_8:BABL_0_1_128:GEGL_0_4_72 GIMP_3_2_0:BABL_0_1_124:GEGL_0_4_68 master:master:master GIMP_3_0_8:BABL_0_1_120:GEGL_0_4_66"

# Ports to install besides the engine sets' own lists, each with its reason.
# mypaint-brushes1: GIMP 3.0.x requires mypaint-brushes-1.0; MacPorts'
# mypaint-brushes port has since moved to 2.0 (what GIMP 3.2 uses), and the
# 1.x brushes now live in this port. An environment workaround for old tags.
EXTRA_PORTS="mypaint-brushes1"

# Shown in GIMP's own about and debug output. Never claim an official GIMP build.
GIMP_BUILD_ID="ch.lkmc.Glims.engine"

# MacPorts base, built from source into _deps/macports without root
# privileges. Upstream GIMP's macOS CI also uses a non-default MacPorts prefix.
MACPORTS_VERSION="2.12.7"
MACPORTS_SHA256="6a3730de846bb78e3fb4ced2ed8d13f777e6aca2ab2f59cade9ca0d549ccc4ba"

# Must equal LSMinimumSystemVersion in Resources/Info.plist (checked at run time).
DEPLOYMENT_TARGET="13.0"
